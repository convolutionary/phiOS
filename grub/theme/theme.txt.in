# phiOS GRUB theme. generated by tools/gengrub.py, fonts filled in by the installer
title-text: ""
desktop-image: "background.png"
desktop-color: "#08080a"
terminal-font: "@F_TERM@"
terminal-box: "terminal_box_*.png"
terminal-left: "8%"
terminal-top: "8%"
terminal-width: "84%"
terminal-height: "84%"
terminal-border: "0"

+ label {
    left = 64%
    top = 28%
    width = 30%
    height = 24
    text = "select a system"
    font = "@F_SMALL@"
    color = "#ecbe40"
}

+ boot_menu {
    left = 64%
    top = 33%
    width = 30%
    height = 40%
    item_font = "@F_ITEM@"
    item_color = "#a8a296"
    selected_item_font = "@F_SEL@"
    selected_item_color = "#f6d77a"
    icon_width = 32
    icon_height = 32
    item_icon_space = 18
    item_height = 56
    item_padding = 14
    item_spacing = 16
    selected_item_pixmap_style = "select_*.png"
    scrollbar = false
}

+ progress_bar {
    id = "__timeout__"
    left = 64%
    top = 76%
    width = 30%
    height = 4
    show_text = false
    fg_color = "#ecbe40"
    bg_color = "#2a2418"
    border_color = "#2a2418"
}

+ label {
    id = "__timeout__"
    left = 64%
    top = 80%
    width = 30%
    height = 20
    text = "booting in %d s"
    font = "@F_SMALL@"
    color = "#6c685f"
}

+ label {
    left = 64%
    top = 92%
    width = 34%
    height = 20
    text = "↑ ↓ move    enter boot    e edit    c console"
    font = "@F_SMALL@"
    color = "#5a564f"
}
