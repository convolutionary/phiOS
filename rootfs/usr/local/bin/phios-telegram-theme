#!/usr/bin/env python3
"""phios-telegram-theme: a Telegram Desktop / AyuGram theme made from the current HyDE theme.

  phios-telegram-theme [--notify | --no-notify] [--out FILE]

Builds ~/Downloads/phiOS.tdesktop-theme from HyDE's colours (accent from the theme's border
colour) with the theme wallpaper, blurred, as the chat background. HyDE runs this on every
theme change (wallbash template ~/.config/hyde/wallbash/always/telegram.dcol).

Telegram can't be switched from outside: a theme only changes when you pick its file in
Settings > Chat Settings > (menu) > Choose from file, then press "Keep changes". Passing the
file on Telegram's command line doesn't work either; that opens the "Forward to" dialog.
So if Telegram is running this only shows a notification saying where the new theme is.
It's written to Downloads because Flatpak Telegram builds can only read that folder.

The colour-to-element map is walogram's constants.tdesktop-theme (MIT), which expects a
16-colour terminal-style palette (color0..color15) plus lighter/darker/alpha variants.
"""
import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile
import zipfile
from pathlib import Path

HOME = Path.home()
CACHE = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache"))
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state"))
OUT = HOME / "Downloads/phiOS.tdesktop-theme"   # Flatpak Telegram builds can only read Downloads
CONSTANTS = [
    Path(__file__).resolve().parent.parent / "share/phios-telegram/constants.tdesktop-theme",
    Path("/usr/local/share/phios-telegram/constants.tdesktop-theme"),
    HOME / ".local/share/phios-telegram/constants.tdesktop-theme",
]
FLATPAKS = ["com.ayugram.desktop", "org.telegram.desktop", "io.github.kotatogram"]
NATIVE = ["AyuGram", "ayugram-desktop", "telegram-desktop", "Telegram", "kotatogram-desktop"]


def rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def hexc(c):
    return "#" + "".join(f"{max(0, min(255, round(v))):02x}" for v in c)


def mix(a, b, t):
    """t=0 -> a, t=1 -> b"""
    return tuple(x + (y - x) * t for x, y in zip(a, b))


def luma(c):
    r, g, b = (v / 255 for v in c)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def read_dcol():
    """the colours HyDE just applied: our wallbash template's output (written right before
    HyDE runs us), else HyDE's own cache of the wallpaper's colours"""
    for f in (CACHE / "hyde/wallbash/telegram.dcol", CACHE / "hyde/wall.dcol"):
        out = {}
        try:
            for line in f.read_text().splitlines():
                m = re.match(r'(dcol_\w+)="([0-9A-Fa-f]{6}|dark|light)"', line)
                if m:
                    out[m.group(1)] = m.group(2)
        except OSError:
            continue
        if "dcol_pry1" in out:
            return out
    return {}


def current_theme():
    try:
        for line in (STATE / "hyde/staterc").read_text().splitlines():
            if line.startswith("HYDE_THEME="):
                return line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return ""


def theme_accents(theme):
    """the theme's own border colours, its most recognisable colours"""
    try:
        text = (CONFIG / "hyde/themes" / theme / "hypr.theme").read_text(errors="replace")
    except OSError:
        return []
    found = []
    for line in text.splitlines():
        if re.match(r"\s*col\.(active|inactive)_border\s*=", line):
            for h in re.findall(r"rgba?\(([0-9a-fA-F]{6})", line):
                if h.lower() not in found:
                    found.append(h.lower())
    return found


def palette():
    d = read_dcol()
    theme = current_theme()
    if "dcol_pry1" not in d:
        sys.exit("phios-telegram-theme: no HyDE colours yet (~/.cache/hyde/wall.dcol); switch theme once")
    bg = rgb(d["dcol_pry1"])
    fg = rgb(d.get("dcol_txt1", "ffffff"))
    light = d.get("dcol_mode") == "light" or luma(bg) > 0.5
    acc = [rgb(h) for h in theme_accents(theme)]
    # accents from the theme; fall back to the wallpaper's accent swatches
    for k in ("dcol_1xa6", "dcol_2xa6", "dcol_3xa6", "dcol_4xa6", "dcol_1xa7", "dcol_2xa7"):
        if k in d:
            acc.append(rgb(d[k]))
    # an accent too close to the background can't carry white text or show selection
    acc = [a for a in acc if abs(luma(a) - luma(bg)) > 0.12] or [mix(fg, bg, 0.4)]
    while len(acc) < 6:
        acc.append(acc[len(acc) % max(1, len(acc))])
    raised = rgb(d["dcol_1xa3"]) if "dcol_1xa3" in d else mix(bg, fg, 0.08)
    if abs(luma(raised) - luma(bg)) < 0.03:
        raised = mix(bg, fg, 0.08)
    c = {
        0: bg, 8: raised, 7: fg, 15: fg,
        2: acc[0],                       # selection, active buttons, outgoing selected
        10: mix(acc[0], fg, 0.25),       # links, "online"
        1: mix(acc[0], bg, 0.45),        # ripples, shadows
        3: acc[1], 4: acc[2], 5: acc[3], 6: acc[4],
        9: mix(acc[1], fg, 0.25), 11: mix(acc[2], fg, 0.25), 12: mix(acc[3], fg, 0.25),
        13: mix(acc[4], fg, 0.25), 14: mix(acc[5], fg, 0.25),
    }
    return c, light, theme


def variants(c, light):
    """walogram's colorLighterN_D / colorDarkerN_D / colorAlphaN_AA. Its map was written for dark
    themes, where 'darker' means 'toward the background'; on a light theme that would turn
    bubbles black, so there the two swap."""
    lines = []
    black, white = (0, 0, 0), (255, 255, 255)
    toward_bg, away_bg = (white, black) if light else (black, white)
    for i in sorted(c):
        col = c[i]
        lines.append(f"color{i}: {hexc(col)};")
        for d in range(10, 100, 10):
            lines.append(f"colorLighter{i}_{d}: {hexc(mix(col, away_bg, d / 100 * 0.9))};")
            lines.append(f"colorDarker{i}_{d}: {hexc(mix(col, toward_bg, d / 100 * 0.9))};")
        for a in ("00", "11", "22", "33", "44", "55", "66", "77", "88", "99", "aa", "bb", "cc", "dd", "ee", "ff"):
            lines.append(f"colorAlpha{i}_{a}: {hexc(col)}{a};")
        lines.append("")
    return "\n".join(lines)


def background(theme, bg, out):
    """the theme wallpaper, blurred and tinted toward the background so text stays readable"""
    link = CONFIG / "hyde/themes" / theme / "wall.set"
    src = str(link.resolve()) if link.exists() else ""
    im = shutil.which("magick") or shutil.which("convert")
    if not src or not im:
        return False
    r = subprocess.run([im, src + "[0]", "-resize", "1920x1080^", "-gravity", "center", "-extent", "1920x1080",
                        "-blur", "0x18", "-fill", hexc(bg), "-colorize", "45%", "-quality", "88", str(out)],
                       capture_output=True)
    return r.returncode == 0 and out.exists()


def build(out):
    const = next((p for p in CONSTANTS if p.is_file()), None)
    if const is None:
        sys.exit("phios-telegram-theme: constants.tdesktop-theme not found")
    c, light, theme = palette()
    colours = f"// phiOS: generated from HyDE theme {theme}\n\n" + variants(c, light) + const.read_text()
    out.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory() as tmp:
        bgfile = Path(tmp) / "background.jpg"
        has_bg = background(theme, c[0], bgfile)
        part = out.with_suffix(".part")
        with zipfile.ZipFile(part, "w", zipfile.ZIP_DEFLATED) as z:
            z.writestr("colors.tdesktop-theme", colours)
            if has_bg:
                z.write(bgfile, "background.jpg")
        os.replace(part, out)
    return theme


def telegram_running():
    if shutil.which("flatpak"):
        apps = subprocess.run(["flatpak", "ps", "--columns=application"], capture_output=True, text=True).stdout.split()
        if any(a in apps for a in FLATPAKS):
            return True
    ps = subprocess.run(["ps", "-eo", "comm="], capture_output=True, text=True).stdout.split()
    return any(n in ps for n in NATIVE)


def main():
    ap = argparse.ArgumentParser(prog="phios-telegram-theme", description=__doc__.split("\n\n")[0])
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--notify", action="store_true", default=True,
                   help="if Telegram is running, say where the new theme is (default)")
    g.add_argument("--no-notify", dest="notify", action="store_false")
    ap.add_argument("--out", type=Path, default=OUT)
    args = ap.parse_args()

    theme = build(args.out)
    print(f"{args.out} ({theme})")
    if args.notify and telegram_running() and shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", "phiOS", "-i", "telegram",
                        f"Telegram theme for {theme} is ready",
                        "In Telegram: Settings › Chat Settings › ⋮ › Choose from file › "
                        f"{args.out.name} in Downloads, then Keep changes."])


if __name__ == "__main__":
    main()
